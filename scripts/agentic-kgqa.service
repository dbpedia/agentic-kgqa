[Unit]
Description=Agentic KGQA – Text2SPARQL API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/agentic-kgqa
EnvironmentFile=-/opt/agentic-kgqa/.env
ExecStart=/opt/agentic-kgqa/.venv/bin/uvicorn src.api:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
